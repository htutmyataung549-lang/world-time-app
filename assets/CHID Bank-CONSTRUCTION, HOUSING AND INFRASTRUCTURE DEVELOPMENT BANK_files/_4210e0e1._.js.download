const stripHtml = (html)=>{
    if (!html) return "";
    return html.replace(/<img[^>]*>/gi, "") // 1. Images နှင့် Base64 Strings များကို ဖျက်မည်
    .replace(/<[^>]*>/g, "") // 2. HTML Tags (<p>, <strong>, etc.) များကို ဖျက်မည်
    .replace(/&nbsp;/g, " ") // 3. &nbsp; များကို Space အဖြစ် ပြောင်းမည်
    .replace(/\s+/g, " ") // 4. Space ပိုများကို ရှင်းထုတ်မည်
    .trim();
};
const truncateText = (text, maxLength = 100)=>{
    if (!text) return "-";
    const cleanedText = stripHtml(text);
    if (!cleanedText) return "-";
    return cleanedText.length > maxLength ? `${cleanedText.substring(0, maxLength)}...` : cleanedText;
};
if (typeof globalThis.$RefreshHelpers$ === 'object' && globalThis.$RefreshHelpers !== null) {
    __turbopack_context__.k.registerExports(__turbopack_context__.m, globalThis.$RefreshHelpers$);
}
